{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build resources",
            "command": "cmd",
            "args": [
                "/c",
                "del /Q \"${workspaceFolder}\\resources.res\" 2>nul & rc.exe /fo \"${workspaceFolder}\\resources.res\" \"${workspaceFolder}\\resources.rc\""
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
				"/Zi",
				"/EHsc",
				"/nologo",
                "/Fo\\Users\\Andrew\\Desktop\\Engine_Console\\build\\obj\\",
				"/FeC:\\Users\\Andrew\\Desktop\\Engine_Console\\build\\Game.exe",
				"C:\\Users\\Andrew\\Desktop\\Engine_Console\\*.cpp", // Сборка всех файлов в папке
                "C:\\Users\\Andrew\\Desktop\\Engine_Console\\Engine\\cpps\\*.cpp",
                "C:\\Users\\Andrew\\Desktop\\Engine_Console\\resources.res",
                "user32.lib",
                "gdi32.lib"
			],

            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "dependsOn": [
                "Build resources"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
